# MQSS SPANK Plugin — plugstack.conf.d drop-in configuration.
#
# This file is installed by CMake into the plugstack.conf.d directory.
# To activate, uncomment the plugin line below and fill in site-specific
# values. The whole directive must stay on a single line; plugstack.conf does
# not support line continuation.

# required @MQSS_SPANK_INSTALL_DIR@/mqss-spank-plugin.so partitions= mqss_base_url= mqss_tokens_file= mqss_qc_id= mqss_qc_alias= mqss_license_prefix= mqss_require_license=
